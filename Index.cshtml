
@{
    ViewData["Title"] = "Dashboard";

    var totalInstructors = ViewBag.TotalInstructors is int count
        ? count : 0;

    var firstName = User.FindFirst("FirstName")?.Value ?? "User";
    var lastName = User.FindFirst("LastName")?.Value ?? "";
    var email = User.Identity?.Name ?? "";

    var initial = string.IsNullOrWhiteSpace(firstName)
        ? "U"
        : firstName.Substring(0, 1).ToUpper();
}

<div class="dashboard-page">

    <!-- Welcome Section -->
    <div class="welcome-section">
        <div>
            <span class="welcome-label">DASHBOARD OVERVIEW</span>
            <h2>Welcome back, @firstName!</h2>
            <p>
                Manage your instructor information and account activities in one place.
            </p>
        </div>

        <div class="welcome-avatar">
            @initial
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="dashboard-grid">

        <!-- Total Instructors -->
        <div class="dashboard-card total-card">

            <div class="card-heading">
                <div>
                    <span class="card-label">TOTAL INSTRUCTORS</span>
                    <h1>@totalInstructors</h1>
                    <p>Registered instructor records</p>
                </div>

                <div class="card-icon teal-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>

            <a asp-controller="Instructors"
               asp-action="Index"
               class="dashboard-link">
                View all instructors
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

        <!-- Add Instructor -->
        <div class="dashboard-card action-card">

            <div class="card-icon teal-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h5>Add New Instructor</h5>

            <p>
                Register a new instructor and add their personal
                and professional information.
            </p>

            <a asp-controller="Instructors"
               asp-action="Create"
               class="dashboard-button">
                Add Instructor
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

        <!-- Manage Records -->
        <div class="dashboard-card action-card">

            <div class="card-icon navy-icon">
                <i class="bi bi-clipboard-data-fill"></i>
            </div>

            <h5>Manage Records</h5>

            <p>
                Search, view, edit, and manage existing
                instructor information.
            </p>

            <a asp-controller="Instructors"
               asp-action="Index"
               class="dashboard-button navy-button">
                Manage Records
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>

    <!-- Account Information -->
    <div class="account-card">

        <div class="account-header">
            <div>
                <h5>Account Information</h5>
                <p>Your registered account details.</p>
            </div>

            <div class="account-icon">
                <i class="bi bi-person-circle"></i>
            </div>
        </div>

        <div class="account-details">

            <div class="account-detail">
                <span>First Name</span>
                <strong>@firstName</strong>
            </div>

            <div class="account-detail">
                <span>Last Name</span>
                <strong>@lastName</strong>
            </div>

            <div class="account-detail">
                <span>Email Address</span>
                <strong>@email</strong>
            </div>

        </div>

        <div class="account-footer">
            <span>
                View or check your personal account information.
            </span>

            <a asp-controller="Account"
               asp-action="Profile"
               class="profile-button">
                <i class="bi bi-person me-1"></i>
                View My Profile
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

    </div>

</div>

<style>

    /* Dashboard Main */

    .dashboard-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 25px 20px;
        color: #831843;
    }

    /* Welcome Section */

    .welcome-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        background: linear-gradient(120deg, #831843, #db2777, #ec4899);
        color: white;
        padding: 30px 35px;
        border-radius: 14px;
        margin-bottom: 25px;
        box-shadow: 0 4px 12px rgba(190, 24, 93, 0.15);
    }

    .welcome-label {
        font-size: 11px;
        letter-spacing: 2px;
        color: #fbcfe8;
        font-weight: 700;
    }

    .welcome-section h2 {
        font-size: 27px;
        font-weight: 700;
        margin: 8px 0;
    }

    .welcome-section p {
        color: #fce7f3;
        margin: 0;
        font-size: 14px;
    }

    .welcome-avatar {
        width: 65px;
        height: 65px;
        min-width: 65px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        border: 2px solid rgba(255,255,255,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
    }

    /* Dashboard Grid */

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .dashboard-card {
        background: white;
        border: 1px solid #fce7f3;
        border-radius: 13px;
        padding: 24px;
        box-shadow: 0 3px 10px rgba(190, 24, 93, 0.05);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 18px rgba(190, 24, 93, 0.10);
    }

    .total-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 220px;
    }

    .card-heading {
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }

    .card-label {
        color: #9d5477;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
    }

    .total-card h1 {
        font-size: 42px;
        font-weight: 700;
        color: #db2777;
        margin: 12px 0 3px;
    }

    .total-card p {
        color: #9d5477;
        font-size: 13px;
    }

    /* Icons */

    .card-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 11px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 23px;
    }

    .teal-icon {
        background: #fce7f3;
        color: #db2777;
    }

    .navy-icon {
        background: #fbcfe8;
        color: #9d174d;
    }

    .dashboard-link {
        color: #db2777;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .dashboard-link:hover {
        color: #9d174d;
        text-decoration: underline;
    }

    /* Action Cards */

    .action-card h5 {
        font-weight: 700;
        font-size: 17px;
        margin: 17px 0 8px;
        color: #831843;
    }

    .action-card p {
        color: #9d5477;
        font-size: 13px;
        line-height: 1.7;
        min-height: 45px;
    }

    .dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #db2777;
        color: white;
        text-decoration: none;
        padding: 10px 15px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        margin-top: 8px;
        transition: background .2s ease;
    }

    .dashboard-button:hover {
        background: #be185d;
        color: white;
    }

    .navy-button {
        background: #9d174d;
    }

    .navy-button:hover {
        background: #831843;
    }

    /* Account Information */

    .account-card {
        background: white;
        border: 1px solid #fce7f3;
        border-radius: 13px;
        padding: 25px;
        box-shadow: 0 3px 10px rgba(190, 24, 93, 0.05);
    }

    .account-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 23px;
    }

    .account-header h5 {
        font-weight: 700;
        margin-bottom: 5px;
        color: #831843;
    }

    .account-header p {
        color: #9d5477;
        font-size: 13px;
        margin: 0;
    }

    .account-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        background: #fce7f3;
        color: #db2777;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .account-details {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
    }

    .account-detail {
        padding: 16px;
        background: #fff7fb;
        border: 1px solid #fce7f3;
        border-radius: 9px;
        min-width: 0;
    }

    .account-detail span {
        display: block;
        color: #9d5477;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .account-detail strong {
        display: block;
        color: #831843;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .account-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-top: 1px solid #fce7f3;
        margin-top: 22px;
        padding-top: 20px;
    }

    .account-footer span {
        color: #9d5477;
        font-size: 13px;
    }

    .profile-button {
        background: #db2777;
        color: white;
        padding: 10px 15px;
        text-decoration: none;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: background .2s ease;
    }

    .profile-button:hover {
        background: #be185d;
        color: white;
    }

    /* Responsive Layout */

    @@media (max-width: 1000px) {
        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .account-details {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .dashboard-page {
            padding: 18px 12px;
        }

        .welcome-section {
            padding: 23px;
        }

        .welcome-section h2 {
            font-size: 21px;
        }

        .welcome-avatar {
            width: 48px;
            height: 48px;
            min-width: 48px;
            font-size: 20px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .account-details {
            grid-template-columns: 1fr;
        }

        .account-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .profile-button {
            text-align: center;
        }
    }

</style>
