
@model InstructorInfoSystem.Models.Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="container py-4" style="max-width: 850px;">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Back to Instructor List
        </a>

        <h2 class="fw-bold mt-3 mb-1">Instructor Details</h2>
        <p class="text-secondary mb-0">
            View the complete personal and professional information of this instructor.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="p-4 p-md-5 text-white"
             style="background: linear-gradient(135deg, #142b52, #2563a6);">

            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3"
                     style="width: 75px; height: 75px; background: rgba(255,255,255,0.18);">
                    @(string.IsNullOrWhiteSpace(Model.FullName)
                        ? "?"
                        : Model.FullName.Substring(0, 1).ToUpper())
                </div>

                <div>
                    <h3 class="fw-bold mb-1">@Model.FullName</h3>
                    <p class="mb-1 text-white-50">@Model.Designation</p>
                    <small class="text-white-50">
                        Instructor ID: #@Model.InstructorId
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">

            <h5 class="fw-bold mb-3">
                <i class="bi bi-person-lines-fill text-primary me-2"></i>
                Personal Information
            </h5>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <small class="text-secondary d-block mb-1">Full Name</small>
                        <span class="fw-semibold">@Model.FullName</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <small class="text-secondary d-block mb-1">Age</small>
                        <span class="fw-semibold">@Model.Age</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <small class="text-secondary d-block mb-1">Gender</small>
                        <span class="fw-semibold">@Model.Gender</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <small class="text-secondary d-block mb-1">Contact Number</small>
                        <span class="fw-semibold">@Model.ContactNumber</span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="bg-light rounded-3 p-3">
                        <small class="text-secondary d-block mb-1">Address</small>
                        <span class="fw-semibold">@Model.Address</span>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">
                <i class="bi bi-mortarboard text-primary me-2"></i>
                Professional Information
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <small class="text-secondary d-block mb-1">Designation</small>
                        <span class="fw-semibold">@Model.Designation</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <small class="text-secondary d-block mb-1">Majorship</small>
                        <span class="fw-semibold">@Model.Majorship</span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="bg-light rounded-3 p-3">
                        <small class="text-secondary d-block mb-1">Bachelor Degree</small>
                        <span class="fw-semibold">@Model.BachelorDegree</span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="bg-light rounded-3 p-3">
                        <small class="text-secondary d-block mb-1">Email Address</small>
                        <span class="fw-semibold text-break">@Model.Email</span>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 justify-content-end">

                <a href="mailto:@Model.Email"
                   class="btn btn-light border px-4">
                    <i class="bi bi-envelope me-1"></i>
                    Compose Email
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.InstructorId"
                   class="btn btn-primary px-4">
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Instructor
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-list me-1"></i>
                    Back to List
                </a>

            </div>

        </div>
    </div>
</div>
