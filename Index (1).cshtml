
@model IEnumerable<InstructorInfoSystem.Models.Instructor>

@{
    ViewData["Title"] = "Instructors";

    var currentSort = ViewData["CurrentSort"]?.ToString();
    var currentFilter = ViewData["CurrentFilter"]?.ToString();
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 0);

    string NextSort(string column) =>
        currentSort == column ? column + "_desc" : column;

    string Arrow(string column) =>
        currentSort == column ? "↑" :
        currentSort == column + "_desc" ? "↓" : "";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Instructor Management</h2>
            <p class="text-secondary mb-1">
                Manage, search, and organize instructor records.
            </p>
            <small class="text-secondary">
                Showing @Model.Count() of @ViewData["TotalCount"] instructors
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            <i class="bi bi-person-plus me-2"></i>
            Add New Instructor
        </a>

    </div>

    <!-- Search Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">

            <form asp-action="Index" method="get">

                <div class="row g-2 align-items-center">

                    <div class="col-12 col-lg-8">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-secondary"></i>
                            </span>

                            <input type="text"
                                   name="searchString"
                                   value="@currentFilter"
                                   class="form-control border-start-0"
                                   placeholder="Search by name, designation, majorship, degree, address, or email..." />
                        </div>
                    </div>

                    <div class="col-6 col-lg-auto">
                        <button type="submit" class="btn btn-primary w-100 px-4">
                            Search
                        </button>
                    </div>

                    <div class="col-6 col-lg-auto">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100 px-4">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Clear
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Message"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Instructor Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-3 p-md-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary fs-5"></i>
                <h5 class="fw-bold mb-0">Instructor Records</h5>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0 instructor-table">

                <thead class="table-light">
                    <tr>

                        <th class="px-3 py-3 text-nowrap">
                            <a asp-action="Index"
                               asp-route-searchString="@currentFilter"
                               asp-route-sortOrder="@NextSort("fullName")"
                               asp-route-page="1"
                               class="text-decoration-none text-dark">
                                Full Name @Arrow("fullName")
                            </a>
                        </th>

                        <th class="py-3">Age</th>
                        <th class="py-3">Address</th>

                        <th class="py-3 text-nowrap">
                            <a asp-action="Index"
                               asp-route-searchString="@currentFilter"
                               asp-route-sortOrder="@NextSort("designation")"
                               asp-route-page="1"
                               class="text-decoration-none text-dark">
                                Designation @Arrow("designation")
                            </a>
                        </th>

                        <th class="py-3">Gender</th>
                        <th class="py-3 text-nowrap">Contact Number</th>
                        <th class="py-3">Majorship</th>
                        <th class="py-3 text-nowrap">Bachelor Degree</th>

                        <th class="py-3 text-nowrap">
                            <a asp-action="Index"
                               asp-route-searchString="@currentFilter"
                               asp-route-sortOrder="@NextSort("email")"
                               asp-route-page="1"
                               class="text-decoration-none text-dark">
                                Email Address @Arrow("email")
                            </a>
                        </th>

                        <th class="text-center py-3" style="min-width: 300px;">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var instructor in Model)
                        {
                            <tr>

                                <td class="px-3 fw-semibold text-nowrap">
                                    @instructor.FullName
                                </td>

                                <td>@instructor.Age</td>

                                <td style="min-width: 160px; max-width: 220px;">
                                    <span class="text-secondary">
                                        @instructor.Address
                                    </span>
                                </td>

                                <td>@instructor.Designation</td>

                                <td>@instructor.Gender</td>

                                <td class="text-nowrap">
                                    @instructor.ContactNumber
                                </td>

                                <td>@instructor.Majorship</td>

                                <td style="min-width: 180px;">
                                    @instructor.BachelorDegree
                                </td>

                                <td>
                                    <a href="mailto:@instructor.Email"
                                       class="text-decoration-none text-primary">
                                        @instructor.Email
                                    </a>
                                </td>

                                <td class="text-center text-nowrap">

                                    <a href="mailto:@instructor.Email"
                                       class="btn btn-sm btn-outline-secondary mb-1">
                                        <i class="bi bi-envelope"></i>
                                        Compose
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@instructor.InstructorId"
                                       class="btn btn-sm btn-outline-info mb-1">
                                        <i class="bi bi-eye"></i>
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@instructor.InstructorId"
                                       class="btn btn-sm btn-outline-primary mb-1">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@instructor.InstructorId"
                                       class="btn btn-sm btn-outline-danger mb-1">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">

                                <i class="bi bi-person-x text-secondary"
                                   style="font-size: 3rem;"></i>

                                <h6 class="fw-bold mt-3 mb-1">
                                    No Instructors Found
                                </h6>

                                <p class="text-secondary mb-3">
                                    No instructor records match your search.
                                </p>

                                <a asp-action="Create"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Add Instructor
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Table Footer -->
        <div class="card-footer bg-white border-0 p-3">
            <small class="text-secondary">
                <i class="bi bi-info-circle me-1"></i>
                Use the column headings to sort instructor records.
                Scroll horizontally to view all columns on smaller screens.
            </small>
        </div>

    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Instructor pages" class="mt-4">

            <ul class="pagination justify-content-center flex-wrap">

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchString="@currentFilter"
                       asp-route-sortOrder="@currentSort"
                       asp-route-page="@(currentPage - 1)">
                        <i class="bi bi-chevron-left me-1"></i>
                        Previous
                    </a>

                </li>

                @for (var p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchString="@currentFilter"
                           asp-route-sortOrder="@currentSort"
                           asp-route-page="@p">
                            @p
                        </a>

                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchString="@currentFilter"
                       asp-route-sortOrder="@currentSort"
                       asp-route-page="@(currentPage + 1)">
                        Next
                        <i class="bi bi-chevron-right ms-1"></i>
                    </a>

                </li>

            </ul>

            <p class="text-center text-secondary small">
                Page @currentPage of @totalPages
            </p>

        </nav>
    }

</div>

<style>
    .instructor-table {
        min-width: 1200px;
    }

    .instructor-table thead th {
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
        color: #334155;
    }

    .instructor-table tbody td {
        font-size: 0.9rem;
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .instructor-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .instructor-table .btn {
        border-radius: 7px;
    }

    .page-link {
        color: #1e3a5f;
    }

    .page-item.active .page-link {
        background-color: #1e3a5f;
        border-color: #1e3a5f;
    }
</style>
