@model InstructorInfoSystem.Models.Instructor

<div class="instructor-form">

    <!-- Personal Information -->
    <div class="form-section">
        <div class="section-header">
            <div class="section-icon">♙</div>
            <div>
                <h5>Personal Information</h5>
                <p>Enter the instructor's personal details.</p>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-12">
                <label asp-for="FullName" class="form-label">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Enter full name" />

                <span asp-validation-for="FullName"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Age" class="form-label">Age</label>

                <input asp-for="Age"
                       type="number"
                       min="18"
                       max="100"
                       class="form-control"
                       value="@(Model == null || Model.Age == 0 ? "" : Model.Age.ToString())"
                       placeholder="Enter age" />

                <span asp-validation-for="Age"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Gender" class="form-label">Gender</label>

                <select asp-for="Gender" class="form-select">
                    <option value="">Select gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>

                <span asp-validation-for="Gender"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ContactNumber"
                       class="form-label">Contact Number</label>

                <input asp-for="ContactNumber"
                       type="tel"
                       class="form-control"
                       placeholder="09123456789" />

                <span asp-validation-for="ContactNumber"
                      class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label">
                    Complete Address
                </label>

                <input asp-for="Address"
                       class="form-control"
                       placeholder="Enter complete address" />

                <span asp-validation-for="Address"
                      class="text-danger small"></span>
            </div>

        </div>
    </div>

    <div class="form-divider"></div>

    <!-- Professional Information -->
    <div class="form-section">

        <div class="section-header">
            <div class="section-icon">▤</div>
            <div>
                <h5>Professional Information</h5>
                <p>Enter the instructor's academic and professional background.</p>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <label asp-for="Designation"
                       class="form-label">Designation</label>

                <input asp-for="Designation"
                       class="form-control"
                       placeholder="e.g. Instructor I" />

                <span asp-validation-for="Designation"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Majorship"
                       class="form-label">Majorship</label>

                <input asp-for="Majorship"
                       class="form-control"
                       placeholder="e.g. Mathematics" />

                <span asp-validation-for="Majorship"
                      class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="BachelorDegree"
                       class="form-label">Bachelor's Degree</label>

                <input asp-for="BachelorDegree"
                       class="form-control"
                       placeholder="e.g. Bachelor of Secondary Education" />

                <span asp-validation-for="BachelorDegree"
                      class="text-danger small"></span>
            </div>

        </div>
    </div>

    <div class="form-divider"></div>

    <!-- Contact Information -->
    <div class="form-section">

        <div class="section-header">
            <div class="section-icon">✉</div>
            <div>
                <h5>Contact Information</h5>
                <p>Provide the instructor's active email address.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email"
                       placeholder="example@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>
        </div>

    </div>

</div>

<style>
    .instructor-form {
        color: #1e293b;
    }

    .form-section {
        padding: 5px 0 20px;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 25px;
    }

    .section-icon {
        width: 43px;
        height: 43px;
        border-radius: 10px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .section-header h5 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 4px;
        color: #172554;
    }

    .section-header p {
        font-size: 12px;
        color: #64748b;
        margin: 0;
    }

    .instructor-form .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .instructor-form .form-control,
    .instructor-form .form-select {
        min-height: 45px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px 13px;
        font-size: 13px;
        background-color: #fff;
    }

        .instructor-form .form-control:focus,
        .instructor-form .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }

        .instructor-form .form-control::placeholder {
            color: #94a3b8;
        }

    .form-divider {
        border-top: 1px solid #e2e8f0;
        margin: 10px 0 25px;
    }

    @@media(max-width: 576px) {
        .section-header {
            align-items: flex-start;
        }

        .instructor-form .row {
            --bs-gutter-y: 1rem;
        }
    }
</style>
