
@model InstructorInfoSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Instructor Information System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #fce7f3, #fff7fb, #fbcfe8);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 45px 42px;
            box-shadow: 0 15px 45px rgba(190, 24, 93, 0.12);
            border: 1px solid #fce7f3;
        }

        /* BRAND */

        .brand {
            text-align: center;
            margin-bottom: 35px;
        }

        .brand-icon {
            width: 68px;
            height: 68px;
            background: linear-gradient(135deg, #9d174d, #ec4899);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            color: white;
            font-size: 32px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(219, 39, 119, .22);
        }

        .brand h1 {
            font-size: 21px;
            font-weight: 700;
            color: #831843;
            margin-bottom: 7px;
        }

        .brand p {
            color: #9d5477;
            font-size: 13px;
            margin: 0;
        }

        /* LOGIN HEADING */

        .login-heading {
            margin-bottom: 25px;
        }

        .login-heading h2 {
            font-size: 26px;
            font-weight: 700;
            color: #831843;
            margin-bottom: 7px;
        }

        .login-heading p {
            color: #9d5477;
            font-size: 14px;
            margin: 0;
        }

        /* FORM */

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #831843;
            margin-bottom: 8px;
        }

        .form-control {
            height: 49px;
            border: 1px solid #f3c4d9;
            border-radius: 9px;
            padding: 12px 14px;
            font-size: 14px;
            background: #fff7fb;
            transition: .2s;
        }

        .form-control:focus {
            background: #ffffff;
            border-color: #ec4899;
            box-shadow: 0 0 0 3px rgba(236, 72, 153, .12);
        }

        /* LOGIN BUTTON */

        .btn-login {
            width: 100%;
            height: 49px;
            background: linear-gradient(135deg, #db2777, #ec4899);
            color: white;
            border: none;
            border-radius: 9px;
            font-size: 15px;
            font-weight: 600;
            margin-top: 12px;
            transition: .2s;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #be185d, #db2777);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(219, 39, 119, .20);
        }

        /* REGISTER LINK */

        .register-section {
            text-align: center;
            margin-top: 27px;
            font-size: 13px;
            color: #9d5477;
        }

        .register-link {
            color: #db2777;
            text-decoration: none;
            font-weight: 700;
            margin-left: 3px;
        }

        .register-link:hover {
            color: #be185d;
            text-decoration: underline;
        }

        /* FOOTER */

        .login-footer {
            text-align: center;
            margin-top: 22px;
            color: #9d5477;
            font-size: 11px;
        }

        /* ALERT */

        .alert {
            font-size: 13px;
            border-radius: 9px;
        }

        .alert-info {
            color: #9d174d;
            background: #fce7f3;
            border-color: #fbcfe8;
        }

        /* VALIDATION */

        .text-danger {
            font-size: 12px;
            color: #e11d48 !important;
        }

        /* RESPONSIVE */

        @@media (max-width: 480px) {
            body {
                padding: 15px;
            }

            .login-card {
                padding: 35px 25px;
            }

            .brand h1 {
                font-size: 19px;
            }

            .login-heading h2 {
                font-size: 23px;
            }
        }
    </style>
</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <div class="brand">
                <div class="brand-icon">▦</div>

                <h1>Instructor Information System</h1>

                <p>Instructor Management Portal</p>
            </div>

            <div class="login-heading">
                <h2>Welcome Back!</h2>
                <p>Enter your account credentials to continue.</p>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">
                    @TempData["Message"]
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="EmailOrId" class="form-label">
                        Email Address or Account ID
                    </label>

                    <input asp-for="EmailOrId"
                           class="form-control"
                           placeholder="Enter your email or ID" />

                    <span asp-validation-for="EmailOrId"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>
                </div>

                <button type="submit" class="btn-login">
                    Sign In
                </button>

            </form>

            <div class="register-section">
                Don't have an account?

                <a asp-controller="Account"
                   asp-action="Register"
                   class="register-link">
                    Create Account
                </a>
            </div>

        </div>

        <div class="login-footer">
            Instructor Information System &copy; @DateTime.Now.Year
        </div>

    </div>

</body>
</html>
